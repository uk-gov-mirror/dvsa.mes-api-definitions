{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotHistory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registration",
    "status"
  ],
  "properties": {
    "registration": {
      "description": "Vehicle registration number",
      "type": "string"
    },
    "make": {
      "description": "Vehicle make",
      "type": "string"
    },
    "model": {
      "description": "Vehicle model",
      "type": "string"
    },
    "expiryDate": {
      "description": "MOT test expiry date",
      "type": ["string", "null"]
    },
    "status": {
      "$ref": "#/definitions/MotStatusCodes"
    }
  },
  "definitions": {
    "MotStatusCodes": {
      "description": "MOT status codes",
      "type": "string",
      "enum": [
        "Valid",
        "Not valid",
        "No details",
        "Age exemption"
      ],
      "tsEnumNames": [
        "VALID",
        "NOT_VALID",
        "NO_DETAILS",
        "AGE_EXEMPTION"
      ]
    }
  }
}
